# =============================================================================
# Travel ETL Pipeline Config
# =============================================================================
# 用法: cp .env.example .env  并填入真实值

# ---- 数据库（P2 启用，P1 可不填）----
DATABASE_URL=postgresql://travel:changeme@localhost:5432/travel_dw

# ---- 高德 Web 服务 Key（Geocoding 必填）----
# 申请: https://lbs.amap.com → 控制台 → 应用管理 → 创建"Web 服务"类型 key
AMAP_API_KEY=

# ---- 数据路径 ----
DATA_DIR=./data
PARQUET_DIR=./data/parquet
DUCKDB_PATH=./data/etl.duckdb

# ---- 运行 ----
LOG_LEVEL=INFO
