# 数据库（默认本地 docker-compose 起的 PG）
DATABASE_URL=postgresql+asyncpg://travel:changeme@localhost:5432/travel_dw

# Redis
REDIS_URL=redis://localhost:6379/0

# 高德 Web API
AMAP_API_KEY=

# API
API_TITLE=旅游数据 API
API_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 缓存（秒）
CACHE_DASHBOARD_TTL=300
CACHE_SPOT_DETAIL_TTL=3600
CACHE_HEATMAP_TTL=3600

# 调度
MV_REFRESH_CRON_HOUR=3      # 每天凌晨 3 点刷物化视图

# Log
LOG_LEVEL=INFO
